# Python 运行环境与缓存
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# 自带外部工具：约 221 MB，可按下 bin/README.md 的版本重新放回
bin/*.exe
bin/*.dll

# 视频与派生产物：体积大且可重新获取，不入库
# （入库的只有 downloads/目押记录.xlsx 与 downloads/xiangtang/参考结果.xlsx 两份比对真值，
#   以及 downloads/流程图/ 下的操作步骤截图——它们是文档的一部分，被 操作步骤.html 引用）
downloads/**/*.mp4
downloads/**/*.avi
downloads/**/*.mkv
downloads/**/*.mov
downloads/**/*.png
downloads/**/*.bmp
downloads/**/证据图/
downloads/**/人工审核结果/
# 操作步骤图示要入库（文档引用它）：单独放行 流程图 目录下的图片
!downloads/流程图/
!downloads/流程图/*.png
# 允许的真值表（! 生效需父目录未被排除：这里只排除上面几类，故无需额外放行）

# 中间产物：重跑即可再生
_reuse/run/

# 编译产物
# 注意：_reuse/dist/*.exe **入库**（用户要求：审核程序是刚需，换机器 clone 下来
# 就能直接用，不必装 VS2022 自己编）。因此这里只排除中间文件，不排除 exe。
# 重新编译会覆盖它们；覆盖后记得一起提交，否则仓库里的 exe 与源码不同步。
_reuse/dist/*.obj
_reuse/dist/*.pdb
_reuse/dist/*.ilk

# 一次性探索脚本的运行日志
*.log

# 参考项目的权重（可由 onnx/ 里已入库的 ONNX 重新导出，见 export_onnx.py）
_reuse/clpr/**/weights/*.pt
_reuse/clpr/**/weights/*.pth

# 超轻量文档生成工具 Archify 的中间产物（校验回执、候选 JSON、生成的独立 HTML）
# 图已经内联进 操作步骤.html，这些不必入库
.archify/

# 系统与编辑器
Thumbs.db
desktop.ini
.vscode/
.idea/

# ultralytics 下载权重时的半成品文件（路径写错才会出现）
_reuse/.yolo11n.pt.*.part
*.part
